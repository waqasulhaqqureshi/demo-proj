# Copy to .env for local runs. On Render these are set in the service's Environment tab.

# Telnyx API v2 key (Mission Control → API Keys). Starts with KEY…
TELNYX_API_KEY=

# Gemini API key (Google AI Studio).
GEMINI_API_KEY=

# Password for the control UI and every /api route. Any long random string.
ADMIN_TOKEN=

# Optional: default caller ID (E.164). The UI lets you pick one per call.
CALLER_ID=

# Optional: Call Control App ID. Leave empty to auto-detect, or create one from the UI.
TELNYX_CONNECTION_ID=

# Public https URL of this server. Render sets RENDER_EXTERNAL_URL automatically;
# locally, set this to an https tunnel (e.g. ngrok) if you want to place calls.
PUBLIC_URL=

# Optional overrides.
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# SYSTEM_PROMPT=You are a friendly AI voice assistant...
PORT=8080
